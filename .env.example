# Copy to .env and fill in. Never commit .env. (Easier: open HQ and use the Settings page.)
# Claude API key from console.anthropic.com. Without it the Boss only understands a few simple commands.
ANTHROPIC_API_KEY=

# Claude model for the Boss. Blank = Opus 5.5, the strongest. Cheaper means: haiku-5-5 < sonnet-5-5 < opus-5-5.
# HQ_MODEL_BOSS=claude-opus-5-5
# Claude model for Chad (picks clip moments). Blank = Sonnet 5.5.
# HQ_MODEL_CHAD=claude-sonnet-5-5
# Claude model for Pitch (writes outreach messages). Blank = Sonnet 5.5. Cheaper means: haiku-5-5 < sonnet-5-5 < opus-5-5.
# HQ_MODEL_PITCH=claude-sonnet-5-5
# Claude model for Scout (rates campaigns). Blank = Haiku 5.5, the cheapest.
# HQ_MODEL_SCOUT=claude-haiku-5-5
# Claude model for Tally (money tracking). Blank = Haiku 5.5, the cheapest.
# HQ_MODEL_TALLY=claude-haiku-5-5
# Claude model for Sweep's daily coach's note. Blank = Sonnet 5.5.
# HQ_MODEL_SWEEP=claude-sonnet-5-5
# Claude model for Captain (answers football questions). Blank = Sonnet 5.5.
# HQ_MODEL_CAPTAIN=claude-sonnet-5-5
# Claude model for the Boss's daily report. Blank = Sonnet 5.5.
# HQ_MODEL_REPORT=claude-sonnet-5-5
# Claude models for the Etsy village: Etta (weekly shop report), Radar (trend research), Quill (shirt words and
# listings). Blank = Sonnet 5.5 for each.
# HQ_MODEL_ETTA=claude-sonnet-5-5
# HQ_MODEL_RADAR=claude-sonnet-5-5
# HQ_MODEL_QUILL=claude-sonnet-5-5
# Stop scheduled agent work for the day once Claude spending reaches this many US dollars (0 = no limit).
HQ_DAILY_BUDGET=5
# Sweep (the janitor and quality control). Local hour of day when Sweep sends its daily "How to improve HQ" report (0-23).
HQ_SWEEP_REPORT_HOUR=8
# Sweep adds a short coach's note to its daily report: one small Claude call, about a cent a day. false turns it off.
HQ_SWEEP_COACH=true
# How many days a downloaded source video stays before Sweep moves it to the trash (you can put it back for a week).
# HQ_SWEEP_KEEP_DAYS=7
# Hours a task can sit "running" before Sweep treats it as stuck and requeues it.
# HQ_SWEEP_STUCK_HOURS=1
# Sweep flags an agent that makes more than this many Claude calls in one hour (a sign of a loop).
# HQ_SWEEP_LOOP_CALLS=30
# Sweep starts a fresh Boss chat when the old one grows past about this many tokens (long chats cost more per message).
# HQ_SWEEP_BOSS_TOKENS=30000

# Muse (the Creative Director). Once about every this many days the Boss sends Muse to think up new ideas, when
# there's room for at least 3 new ones. Set HQ_MUSE=false to stop the weekly round (Brainstorm now still works).
HQ_MUSE_EVERY_DAYS=7
# Most Muse may spend on Claude in a month, in US dollars (0 = Muse is off). On Sonnet a weekly round costs up to
# about $0.07 (it goes through Claude's half-price batch queue) and Brainstorm now up to about $0.14.
HQ_MUSE_MONTHLY_BUDGET=3
# How many ideas Muse keeps open at once (3 to 8).
HQ_MUSE_IDEAS=5
# How many of Muse's best ideas go to Approvals and your phone each round.
HQ_MUSE_TO_APPROVALS=3
# Muse runs on Sonnet 5.5. For bolder ideas at about twice the price per round, uncomment the next line.
# HQ_MODEL_MUSE=claude-opus-5-5
# How hard Muse thinks: low, medium (default) or high (deeper, costs more).
# HQ_MUSE_EFFORT=medium
# Send the weekly round through Claude's half-price batch queue (ideas within the hour). false = live at full price (ideas in a minute).
# HQ_MUSE_BATCH=true
# Turn Muse's automatic weekly round on or off. Brainstorm now still works when off.
# HQ_MUSE=true

# Build it: send an idea you approve straight to Claude, which builds it in CHADCLIP and opens a pull request.
# One-time setup on claude.ai: Scheduled, New task, Code, repo CHADCLIP, no schedule, Add trigger, API, Generate
# token. Paste the token here and the address ending in /fire below. Without them, Build it gives you a brief to copy.
HQ_BUILD_TOKEN=
HQ_BUILD_URL=

# Warrior Village (football). Folder for the football Inbox and Outbox. Point it at a Google Drive folder (like
# G:\My Drive\HQ Football) to move Hudl exports and reports between your Mac and this PC. Blank = data/football.
HQ_FOOTBALL_DIR=
# Daily Claude budget for the football agents, in US dollars, separate from the one above (0 = no limit).
HQ_FOOTBALL_DAILY_BUDGET=1
# Hour (local time) Clock texts your phone what's due or late this game week.
HQ_FOOTBALL_REMINDER_HOUR=8
# Thursday print. Your "2026 WSU FOOTBALL" folder on this PC, with one subfolder per opponent. Once a week Clock prints the
# documents in the folder for that week's opponent. HQ creates the opponent folders for you. A Google Drive folder synced
# to this PC works too. Blank = a "2026 WSU FOOTBALL" folder next to the football Inbox and Outbox.
HQ_PRINT_DIR=
# Printer name exactly as Windows shows it (Settings > Printers). Blank = your default printer.
HQ_PRINTER=
# Day of the weekly print (0 = Monday ... 3 = Thursday ... 6 = Sunday).
HQ_PRINT_WEEKDAY=3
# Hour (24-hour, local time) of the weekly print.
HQ_PRINT_HOUR=20
# Hour (24-hour, local time) on Monday when Depth builds the week's opponent personnel sheet.
HQ_DEPTH_HOUR=8
# Hour (24-hour, local time) on Monday when Tells builds the week's scouting report from the newest Hudl export.
HQ_SCOUTING_HOUR=17

# Etsy village (shirts). Printify API token: Printify > My account > Connections > API tokens > Generate (all
# scopes). Dock uses it to build approved shirts in Printify and to watch orders. It never publishes a listing and
# never sends an order to production: you do both in Printify. Also turn on manual order approval in Printify.
HQ_PRINTIFY_TOKEN=
# Printify shop id. Blank = your Etsy-connected shop (or your first one).
HQ_PRINTIFY_SHOP_ID=
# Printify shirt to print on: 12 = Bella+Canvas 3001 unisex tee. Print provider id; blank = Printify Choice.
HQ_PRINTIFY_BLUEPRINT=12
HQ_PRINTIFY_PROVIDER=
# How many new shirt designs Quill writes a day, and how many may wait unbuilt before it stops for you to catch up.
HQ_ETSY_DESIGNS_PER_DAY=4
HQ_ETSY_MAX_WAITING=8
# Show me new designs before they're built: auto = the first 5 and any with warnings, then automatic; always; never
# (designs with warnings always come to you).
HQ_ETSY_REVIEW_DESIGNS=auto
# Claude budget for the Etsy village, in US dollars, separate from the others (0 = no limit). Pictures count too.
HQ_ETSY_DAILY_BUDGET=0.5
HQ_ETSY_MONTHLY_BUDGET=15
# What one shirt costs you in Printify, in US dollars, for the profit estimate on each design.
HQ_ETSY_SHIRT_COST=12
# Optional pictures on designs. An OpenAI API key (platform.openai.com > API keys). Blank = words-only designs, free.
HQ_OPENAI_API_KEY=
# Image model, what one picture costs (US dollars) and the most pictures may cost a month (0 = no pictures).
HQ_ETSY_IMAGE_MODEL=gpt-image-1
HQ_ETSY_IMAGE_COST=0.05
HQ_ETSY_IMAGE_MONTHLY=3

# Whisper model for transcripts: tiny, base, small, medium, large-v3
HQ_WHISPER_MODEL=small
# Practice posting: approved clips are saved to data/practice-posts instead of uploaded. auto = on until a real
# posting account is switched on. true = always also practice, false = never.
HQ_PRACTICE_POSTING=auto
# Set to false only when you trust Chad enough to post without your approval.
HQ_REQUIRE_APPROVAL=true
# Pause All: true stops every agent and all posting (the Boss still chats). The dashboard's Pause button and
# texting "pause" or "resume" to your Relay bot flip this for you.
HQ_PAUSED=false
# Most posts Chad may make per day on each account (any 24 hours). Bursts look like spam and get new accounts
# limited, so raise this slowly. 0 = no limit. The practice account ignores it.
HQ_MAX_POSTS_PER_DAY=4
# Most new clips Chad makes per day (never below 4). Chad also makes none while more clips than a day of posting
# are still waiting, so clips are fresh when they go out.
HQ_MAX_CLIPS_PER_DAY=6
# Minimum minutes between two posts on the same account. 0 = no gap. The practice account ignores it.
HQ_POST_GAP_MINUTES=60
# Hour (local time) for the Boss's daily report.
HQ_REPORT_HOUR=9

# A second place for the daily backup, e.g. a Google Drive folder on this PC (G:\My Drive\HQ backups). Keys and
# passwords are left out of this copy. Empty = backups stay only in data/backups on this PC.
HQ_BACKUP_COPY_DIR=

# Dashboard password. Required to open HQ from another computer (start-hq.bat or a server).
HQ_PASSWORD=

# Optional, Instagram only: a public address where data/clips can be reached. Leave empty and HQ uploads clips
# straight to Instagram instead.
HQ_PUBLIC_BASE_URL=

# Connect Instagram: App ID and App secret from your Meta app (developers.facebook.com > your app > Settings > Basic).
# Then follow the steps in the Connect Instagram box below.
IG_APP_ID=
IG_APP_SECRET=

# Connect TikTok: HQ logs in once and renews the token itself (TikTok tokens only last a day on their own).
# Copy the Client key and Client secret from your app on developers.tiktok.com, then press Connect TikTok below.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# The https page TikTok sends you back to. Must be the same address you gave Login Kit in your TikTok app.
TIKTOK_REDIRECT_URI=

# Per-account secrets named in config/accounts.yaml
TIKTOK_ACCESS_TOKEN_MAIN=
IG_USER_ID_MAIN=
IG_ACCESS_TOKEN_MAIN=

# Twitch developer app (https://dev.twitch.tv/console), used to rank top streamers and fetch clips
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Pitch can email an approved message for you (nothing sends until you press "Send email" on a draft).
# 1) Your Gmail address. 2) An app password: turn on 2-Step Verification, then make one at myaccount.google.com/apppasswords.
PITCH_EMAIL_ADDRESS=
PITCH_EMAIL_APP_PASSWORD=
# Private sample clips: the address streamers can open your HQ at (for example a Tailscale Funnel link), no trailing slash.
# Without it Pitch still makes samples for you to watch, but can't put a link in the email.
HQ_SAMPLE_BASE_URL=

# Relay: the Boss and clip approvals on your phone through Telegram (free).
# 1) In Telegram, message @BotFather, send /newbot, and paste the token here.
# 2) Send your new bot "hi", then run: python -m hq relay-id   and paste the number it prints.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Scout looks for campaigns on its own. Public campaign pages or RSS feeds to read (comma separated). Optional.
# Scout checks each site's robots.txt first and never opens Whop or Discord (their rules forbid it).
SCOUT_FEED_URLS=
# Scout searches the open web once a day for new campaigns (about 10 cents a day). 0 turns it off.
# Needs web search switched on for your Anthropic organization (Console, Settings, Privacy).
SCOUT_WEB_SEARCH=1
# Claude model for that search. Blank = Sonnet 5.5. Use claude-opus-5-5 for a deeper search at higher cost.
# HQ_MODEL_SCOUT_SEARCH=claude-sonnet-5-5
# Scout only pings your phone for campaigns it scores at least this high (0 to 10).
SCOUT_MIN_SCORE=6
# Most campaigns Scout rates per run, to keep the Claude bill small.
SCOUT_MAX_PER_RUN=10
