# Copy to .env and fill in. Never commit .env. (Easier: open HQ and use the Settings page.)
# Claude API key from console.anthropic.com. Without it the Boss only understands a few simple commands.
ANTHROPIC_API_KEY=

# Which Claude model each agent uses. Defaults: Boss on Opus 5.5, Chad on Sonnet 5.5, everyone else on Haiku 5.5.
# Uncomment to change one. Cheaper means: haiku-5-5 < sonnet-5-5 < opus-5-5.
# HQ_MODEL_BOSS=claude-opus-5-5
# HQ_MODEL_CHAD=claude-sonnet-5-5
# Stop scheduled agent work for the day once Claude spending reaches this many US dollars (0 = no limit).
HQ_DAILY_BUDGET=0

# Whisper model for transcripts: tiny, base, small, medium, large-v3
HQ_WHISPER_MODEL=small
# Practice posting: approved clips are saved to data/practice-posts instead of uploaded. auto = on until a real
# posting account is switched on. true = always also practice, false = never.
HQ_PRACTICE_POSTING=auto
# Set to false only when you trust Chad enough to post without your approval.
HQ_REQUIRE_APPROVAL=true
# Hour (local time) for the Boss's daily report.
HQ_REPORT_HOUR=9

# Dashboard password. Required to open HQ from another computer (start-hq.bat or a server).
HQ_PASSWORD=

# Needed for Instagram (it fetches clips from this public address).
HQ_PUBLIC_BASE_URL=

# Connect TikTok: HQ logs in once and renews the token itself (TikTok tokens only last a day on their own).
# Copy the Client key and Client secret from your app on developers.tiktok.com, then press Connect TikTok below.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# The https page TikTok sends you back to. Must be the same address you gave Login Kit in your TikTok app.
TIKTOK_REDIRECT_URI=

# Per-account secrets named in config/accounts.yaml
TIKTOK_ACCESS_TOKEN_MAIN=
IG_USER_ID_MAIN=
IG_ACCESS_TOKEN_MAIN=

# Twitch developer app (https://dev.twitch.tv/console), used to rank top streamers and fetch clips
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Relay: the Boss and clip approvals on your phone through Telegram (free).
# 1) In Telegram, message @BotFather, send /newbot, and paste the token here.
# 2) Send your new bot "hi", then run: python -m hq relay-id   and paste the number it prints.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Scout looks for campaigns on its own. Public campaign pages or RSS feeds to read (comma separated). Optional.
# Scout checks each site's robots.txt first and never opens Whop or Discord (their rules forbid it).
SCOUT_FEED_URLS=
# Scout only pings your phone for campaigns it scores at least this high (0 to 10).
SCOUT_MIN_SCORE=6
# Most campaigns Scout rates per run, to keep the Claude bill small.
SCOUT_MAX_PER_RUN=10
