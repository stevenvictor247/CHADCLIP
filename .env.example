# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Whisper model for transcripts: tiny, base, small, medium, large-v3
HQ_WHISPER_MODEL=small
# Set to false only when you trust Chad enough to post without your approval.
HQ_REQUIRE_APPROVAL=true
# Hour (local time) for the Boss's daily report.
HQ_REPORT_HOUR=9

# Dashboard password. Required to open HQ from another computer (start-hq.bat or a server).
HQ_PASSWORD=

# Needed for Instagram (it fetches clips from this public address).
HQ_PUBLIC_BASE_URL=

# Per-account secrets named in config/accounts.yaml
TIKTOK_ACCESS_TOKEN_MAIN=
IG_USER_ID_MAIN=
IG_ACCESS_TOKEN_MAIN=

# Twitch developer app (https://dev.twitch.tv/console), used to rank top streamers and fetch clips
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
